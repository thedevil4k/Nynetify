FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    cmake \
    build-essential \
    pkg-config \
    libfltk1.3-dev \
    libmpv-dev \
    mpv \
    wget \
    python3-pip \
    python3-pil \
    dpkg-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY . .

RUN chmod +x scripts/build-deb.sh && scripts/build-deb.sh
